{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "rstack-library-starter",
  "version": "1.2.1",
  "private": true,
  "description": "Rstack Library Starter Template",
  "keywords": [],
  "homepage": "https://github.com/logue/rstack-library-starter",
  "bugs": {
    "url": "https://github.com/logue/rstack-library-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/rstack-library-starter.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "import": "./dist/index.umd.js",
      "default": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "rs dev",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rs lint . --fix",
    "lint:prettier": "rs fmt .",
    "analyze": "RSDOCTOR=true rs lib",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "clean": "rimraf demo dist docs",
    "clean:hard": "rimraf demo dist docs node_modules/.tmp node_modules/.cache",
    "build": "rs lib",
    "build:demo": "rs build",
    "preview": "rs preview",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rsdoctor/cli": "^1.6.4",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.2",
    "cross-env": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "rstack": "^0.8.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
