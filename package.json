{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "rstack-library-starter",
  "private": true,
  "version": "0.4.2",
  "description": "Rstack Library Starter Template",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/rstack-library-starter",
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/rstack-library-starter.git"
  },
  "bugs": {
    "url": "https://github.com/logue/rstack-library-starter/issues"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "default": "./dist/index.umd.js",
      "import": "./dist/index.umd.js"
    },
    "./mf-manifest.json": "./dist/mf-manifest.json",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.25.0",
  "sideEffects": false,
  "scripts": {
    "dev": "rslib --watch",
    "dev:demo": "rsbuild --open",
    "lint": "run-s 'lint:*' --",
    "lint:biome": "biome check --write",
    "lint:rslint": "rslint . --fix",
    "inspect": "rslib inspect",
    "inspect:demo": "rsbuild inspect",
    "build": "rslib build",
    "build:demo": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "clean": "rimraf demo dist docs",
    "clean:hard": "rimraf demo dist docs node_modules/.tmp node_modules/.cache",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@eslint/markdown": "^8.0.3",
    "@logue/biome-plugins": "^0.0.3",
    "@microsoft/api-extractor": "^7.59.0",
    "@module-federation/rsbuild-plugin": "^2.9.0",
    "@rsbuild/core": "^2.2.1",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.9.0",
    "@rstest/adapter-rslib": "^0.11.11",
    "@rstest/core": "^0.11.11",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.4.0",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}