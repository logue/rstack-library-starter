{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "rstack-library-starter",
  "private": true,
  "version": "0.2.0",
  "description": "Rstack Library Starter Template",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "homepage": "https://github.com/logue/rstack-library-starter.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/rstack-library-starter.js.git"
  },
  "bugs": {
    "url": "https://github.com/logue/rstack-library-starter.js/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "default": "./dist/index.es.js"
    },
    "./umd": {
      "default": "./dist/index.umd.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.22.0",
  "sideEffects": false,
  "scripts": {
    "dev": "rslib --watch",
    "dev:docs": "rsbuild",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rslint .",
    "lint:biome": "biome check --write",
    "inspect": "rslib inspect",
    "inspect:docs": "rsbuild inspect",
    "build": "rslib build",
    "build:docs": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "clean": "rimraf dist docs",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.cache",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@microsoft/api-extractor": "^7.58.12",
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "^0.8.0",
    "@rstest/adapter-rslib": "^0.11.8",
    "@rstest/core": "^0.11.8",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.2.0",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
