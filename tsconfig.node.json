{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "**/node_modules",
    "**/.*/"
  ],
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "include": [
    "env.d.ts",
    "rsbuild.config.*",
    "rslib.config.*",
    "rslint.config.*",
    "rspress.config.*",
    "package.json"
  ]
}
