{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "include": [
    "env.d.ts",
    "rsbuild.config.*",
    "rslib.config.*",
    "rslint.config.*",
    "rspress.config.*",
    "package.json"
  ],
  "exclude": ["**/node_modules", "**/.*/"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./.rstack/.tmp/tsconfig.node.tsbuildinfo"
  }
}
